#!/usr/bin/env bash
# Controls individual model-engine builds under builds/<id>/docker-compose.yaml
# directly - each build is its own standalone compose project, never routed
# through a shared global compose file. Safe to run against a read-only
# checkout: every subcommand only ever reads files under builds/ and talks to
# the host's docker daemon, nothing here writes into this repo's checkout.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
BUILDS_DIR="$HERE/builds"

usage() {
  cat >&2 <<'EOF'
Usage:
  modelctl up [<build-id>...] [--exclusive]
  modelctl up --standing <path-to-standing-list> [--exclusive]
  modelctl down [<build-id>...]
  modelctl logs [<logs-options>] [<build-id>...]
  modelctl list
  modelctl ps
  modelctl exec <build-id> [<cmd>...]

up with no arguments and no --standing is an error - it never guesses which
builds to start. down and logs with no arguments act on everything
(down: every build directory; logs: every currently-running build container).

--standing without --exclusive refuses to start anything at all if a build
outside the standing list is already running, leaving the decision to the
caller. --exclusive stops those first instead of refusing. This mode is
global (box-wide), not GPU-scoped - --standing's whole point is guaranteeing
a known set is running everywhere, not just on one GPU.

--exclusive with plain build-id(s) (no --standing) is GPU-scoped instead:
it stops every OTHER model build sharing a GPU with any of the given ids
(reading each build's own build.yaml derived.target_gpu), then starts the
given ids - regardless of any always-up tag, and regardless of whether they
were already running. Any caller that wants a GPU to itself for a specific
build or set of builds (the benchmark tool, or a one-off manual test) should
use this instead of stopping things itself.

list shows every build in the catalog (running or not); ps shows only
currently-running ones, like `docker compose ps`. exec defaults to `sh`
if no command is given.

logs options are `docker logs`' own, passed through, and may appear before
or after the build ids:
  -f, --follow      keep streaming new output instead of printing and exiting
  -n, --tail <n>    only the last <n> lines per build (integer or "all")
      --since <ts>  only logs since this timestamp ("10m", "2026-09-28T00:00Z")
      --until <ts>  only logs before this timestamp
  -t, --timestamps  prefix each line with its container-log timestamp
      --details     show extra details provided to logs
`docker logs` itself takes exactly one container, so for several ids modelctl
runs one per build: a single id prints output exactly as `docker logs` does,
several prefix every line with [<build-id>] so interleaved output stays
attributable - followed in parallel (Ctrl-C to stop), printed one build at a
time without -f. Ids resolve by container name, which is every build's own
id (its compose `container_name`), so a stopped build still prints its
history - it just has nothing to follow.
EOF
  exit 1
}

compose_file_for() {
  echo "$BUILDS_DIR/$1/docker-compose.yaml"
}

# Compose project names are far stricter than build directory names: only
# lowercase alphanumerics, hyphens, and underscores, must start with a
# letter or digit. Build ids commonly carry version-number periods (e.g.
# "qwen3.8-27b-..."), which `docker compose -p` rejects outright -
# confirmed live, this is not a hypothetical. Periods become underscores;
# every build id here already starts with a letter or digit and is
# already lowercase, so nothing else needs handling.
project_name_for() {
  echo "${1//./_}"
}

all_build_ids() {
  local dir
  for dir in "$BUILDS_DIR"/*/; do
    [ -f "$dir/docker-compose.yaml" ] || continue
    basename "$dir"
  done
}

running_build_ids() {
  local bid
  while IFS= read -r bid; do
    if docker ps --format '{{.Names}}' | grep -qx "$bid"; then
      echo "$bid"
    fi
  done < <(all_build_ids)
}

contains() {
  local needle="$1"
  shift
  local x
  for x in "$@"; do
    [ "$x" = "$needle" ] && return 0
  done
  return 1
}

# A build's model directory is wherever its compose file mounts model
# weights from under /var/lib/ai-models - checked for a .download-complete
# marker before ever starting the container. Two conventions exist across
# the engines actually in use here:
#   - a specific subdirectory mounted directly (llama.cpp/ds4-style:
#     "/var/lib/ai-models/<name>:/models:ro") - the mount source IS the
#     model directory.
#   - the whole /var/lib/ai-models tree mounted, with the specific model
#     referenced only inside `command:` (vLLM-style: "vllm serve
#     /models/<name> ...") - the model directory has to be reconstructed
#     from that command argument.
# A third convention (Ollama-style: the whole tree mounted read-only as
# /gguf-source, with model selection happening out-of-band via `ollama
# create` after the container is already up) has no compose-file-visible
# reference to a specific model directory at all - model_dir_for returns
# nothing for these, and the preflight check below degrades to a warning
# instead of a hard refusal, since there's nothing here to verify against.
model_dir_for() {
  local f="$1"
  local mount
  # Match only real volume LIST ITEMS, not any mention of the path: this greps
  # the whole file, and a compose whose documentation comment names a model path
  # would otherwise be read as that build's model directory. That happened - a
  # comment saying where the shared MTP head lands made the preflight check
  # "<that dir>/MTP/.download-complete" and refuse to start a build whose actual
  # model was present. Restricting to a leading "- " also excludes commented-out
  # mounts, since those begin with "#".
  mount="$(grep -E '^[[:space:]]*-[[:space:]]*/var/lib/ai-models/[^:[:space:]]+' "$f" \
             | grep -oE '/var/lib/ai-models/[^:[:space:]]+' | head -1 || true)"
  if [ -n "$mount" ]; then
    echo "$mount"
    return
  fi
  if grep -q '/var/lib/ai-models:/models' "$f"; then
    local rel
    rel="$(grep -oE '/models/[^ '\''"[:space:]]+' "$f" | head -1 || true)"
    if [ -n "$rel" ]; then
      echo "/var/lib/ai-models${rel#/models}"
      return
    fi
  fi
  return 1
}

port_for() {
  local f="$1"
  grep -oE '127\.0\.0\.1:[0-9]+' "$f" | head -1 | cut -d: -f2
}

# DEFAULT_TARGET_GPU mirrors the reasoning llm-inference-bench/app/
# orchestrator.py used to carry itself before its own GPU-exclusivity logic
# moved here (2026-09-01, M-139): every build.yaml predating the R9700
# (2026-08-20) has no target_gpu field at all, and every one of those builds
# is strix-apu in reality (vLLM builds are architecture-locked to gfx1151,
# everything else predates the second GPU existing) - so defaulting a
# missing/unreadable target_gpu to strix-apu is a real fact about this box's
# current builds, not a guess.
DEFAULT_TARGET_GPU="strix-apu"

is_model_build() {
  [ -f "$BUILDS_DIR/$1/build.yaml" ]
}

# Which GPU (catalog/hardware.yaml id) a build targets, read from its own
# build.yaml (derived.target_gpu) via a targeted grep rather than a real
# YAML parser - same style as model_dir_for/port_for above, and this file's
# structure (a flat, 2-space-indented `key: value` line directly under
# `derived:`) is simple enough that a real parser buys nothing. Falls back
# to DEFAULT_TARGET_GPU for any build.yaml missing the field, or any build
# with no build.yaml at all (never called for those - see
# stop_other_builds_on_same_gpu, which only calls this for ids that pass
# is_model_build).
target_gpu_for() {
  local id="$1"
  local f="$BUILDS_DIR/$id/build.yaml"
  local gpu=""
  if [ -f "$f" ]; then
    gpu="$(grep -oE '^[[:space:]]*target_gpu:[[:space:]]*[^[:space:]#]+' "$f" | head -1 | sed -E 's/^[^:]+:[[:space:]]*//')"
  fi
  echo "${gpu:-$DEFAULT_TARGET_GPU}"
}

# Stops every OTHER currently-running model build that targets the same
# GPU(s) as any of the given ids - the given ids themselves are left alone
# (cmd_up_one brings them up next). GPU-scoped so an exclusive start on one
# GPU never disturbs a standing model on another. Ported from
# llm-inference-bench/app/orchestrator.py's own _establish_exclusivity
# (2026-09-01, M-139) - that tool's own copy of this logic is gone now; it
# just calls `modelctl up <ids> --exclusive` like any other caller, so it
# no longer needs to care whether a target is tagged always-up or already
# running - this handles both uniformly, same as it always has for
# non-benchmark callers.
stop_other_builds_on_same_gpu() {
  local ids=("$@")
  local target_gpus=() id gpu
  for id in "${ids[@]}"; do
    gpu="$(target_gpu_for "$id")"
    contains "$gpu" "${target_gpus[@]:-}" || target_gpus+=("$gpu")
  done
  echo "modelctl: --exclusive - target(s) are on GPU(s): ${target_gpus[*]}" >&2
  local rid rgpu stopped_any=0
  while IFS= read -r rid; do
    contains "$rid" "${ids[@]}" && continue
    is_model_build "$rid" || continue
    rgpu="$(target_gpu_for "$rid")"
    contains "$rgpu" "${target_gpus[@]}" || continue
    echo "modelctl: --exclusive - stopping '$rid' (same GPU: $rgpu)" >&2
    cmd_down_one "$rid" || echo "modelctl: warning - failed to stop '$rid', continuing" >&2
    stopped_any=1
  done < <(running_build_ids)
  [ "$stopped_any" -eq 0 ] && echo "modelctl: --exclusive - no other model builds on this GPU" >&2
  return 0
}

# Polls a build's port until it answers or WAIT_HEALTHY_TIMEOUT_S elapses.
# Tries /health, /, then /v1/models in turn per attempt - covers vLLM/
# llama-server (/health), ollama (/ answers "Ollama is running"), and
# ds4-server (only ever answers /v1/models) without needing to know which
# engine a given build actually is.
wait_healthy() {
  local id="$1"
  local port="$2"
  local timeout="${WAIT_HEALTHY_TIMEOUT_S:-1200}"
  local deadline=$(( $(date +%s) + timeout ))
  local path
  echo "modelctl: waiting for $id to become healthy on :$port ..." >&2
  while [ "$(date +%s)" -lt "$deadline" ]; do
    for path in /health / /v1/models; do
      if curl -sf -o /dev/null -m 5 "http://localhost:$port$path" 2>/dev/null; then
        echo "modelctl: $id healthy on :$port" >&2
        return 0
      fi
    done
    sleep 5
  done
  echo "modelctl: warning - $id did not become healthy on :$port within ${timeout}s, continuing anyway" >&2
  return 1
}

# Warm a freshly started model before anything measures it.
#
# Why here rather than in the benchmark tool: priming belongs to *starting* a
# model, not to benchmarking one, and every consumer (benchmarks, ad-hoc A/Bs,
# litellm traffic) passes through `up`. The bench tool has its own per-cell
# warmup, but that is per-cell and capped; it cannot undo a cold model, and the
# orchestrator runs `up` immediately before measuring, so the first cell
# otherwise pays for graph/JIT compilation and a cold page cache.
#
# Deliberately best-effort: a model that is up but refuses to answer a prompt is
# a real problem, but it is not one that `up` should fail over, and not every
# engine in the catalog speaks the same API. Failures are logged and ignored.
# MODELCTL_PRIME=0 skips it.
#
# What this can and cannot warm: it compiles the graphs and pulls weights and
# code pages in, which is the start-up transient. It CANNOT warm the pages a
# later measured prompt will touch, because the gather path reads rows keyed by
# the text's own n-grams -- a different body warms different pages. So this
# removes start-up transients, not measurement-body effects.
prime_model() {
  local id="$1"
  local port="$2"
  [ "${MODELCTL_PRIME:-1}" = "0" ] && return 0
  local body='{"messages":[{"role":"user","content":"hi"}],"max_tokens":8,"temperature":0}'
  local i
  for i in 1 2; do
    if curl -sf -o /dev/null -m 120 -X POST \
         -H 'Content-Type: application/json' -d "$body" \
         "http://localhost:$port/v1/chat/completions" 2>/dev/null; then
      echo "modelctl: primed $id on :$port" >&2
      return 0
    fi
    # llama.cpp's native endpoint, for builds whose server does not expose the
    # OpenAI chat route yet.
    if curl -sf -o /dev/null -m 120 -X POST \
         -H 'Content-Type: application/json' \
         -d '{"prompt":"hi","n_predict":8,"temperature":0}' \
         "http://localhost:$port/completion" 2>/dev/null; then
      echo "modelctl: primed $id on :$port (native /completion)" >&2
      return 0
    fi
    sleep 2
  done
  echo "modelctl: warning - could not prime $id on :$port (continuing; the first request will pay the start-up cost)" >&2
  return 0
}

preflight_up() {
  local id="$1"
  local f
  f="$(compose_file_for "$id")"
  if [ ! -f "$f" ]; then
    echo "modelctl: refusing to start '$id' - no such build (missing $f)" >&2
    return 1
  fi
  local model_dir
  if model_dir="$(model_dir_for "$f")"; then
    if [ ! -f "$model_dir/.download-complete" ]; then
      echo "modelctl: refusing to start '$id' - download not complete (missing $model_dir/.download-complete)" >&2
      return 1
    fi
  else
    echo "modelctl: warning - '$id' has no compose-file-visible model directory (Ollama-style build); skipping download-completion check" >&2
  fi
}

cmd_up_one() {
  local id="$1"
  preflight_up "$id" || return 1
  echo "modelctl: starting $id"
  # -p is mandatory, not cosmetic: every build's compose file declares
  # `name: docker` (matching the global base-stack compose file's own
  # project name), so without an explicit override every build and the
  # base stack share one Compose project and its default network.
  # project_name_for(id) is guaranteed unique (build directory names are
  # unique) and gives each build its own isolated project, independent
  # of every other build and of the base stack.
  docker compose -p "$(project_name_for "$id")" -f "$(compose_file_for "$id")" up -d
}

cmd_up() {
  local ids=()
  local standing=0
  local exclusive=0
  local list_path=""

  # --exclusive is valid in either position (before/after ids, with or
  # without --standing); --standing takes its path as the very next arg.
  # Everything left over after pulling those two out is the plain build-id
  # list.
  local args=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --exclusive)
        exclusive=1
        ;;
      --standing)
        standing=1
        shift
        list_path="${1:-}"
        if [ -z "$list_path" ]; then
          echo "modelctl: --standing requires a path" >&2
          exit 1
        fi
        ;;
      *)
        args+=("$1")
        ;;
    esac
    shift
  done

  if [ "$standing" -eq 1 ]; then
    if [ ! -f "$list_path" ]; then
      echo "modelctl: standing list not found: $list_path" >&2
      exit 1
    fi
    local line
    while IFS= read -r line; do
      line="${line%%#*}"
      line="$(echo "$line" | xargs || true)"
      [ -z "$line" ] && continue
      ids+=("$line")
    done <"$list_path"
  elif [ "${#args[@]}" -gt 0 ]; then
    ids=("${args[@]}")
  else
    echo "modelctl up: no build ids given and no --standing <path> supplied" >&2
    usage
  fi

  if [ "$standing" -eq 1 ]; then
    # --standing's whole point is guaranteeing a known set is running,
    # box-wide - something already up outside that set is exactly the
    # ambiguous case this must never paper over silently. Refuse by
    # default; --exclusive opts into having modelctl resolve it by
    # stopping the extras itself. Deliberately NOT GPU-scoped (unlike the
    # plain-id-list case below) - a standing-set enforcement pass means
    # the whole box, not one GPU's worth.
    local extra=()
    local rid
    while IFS= read -r rid; do
      contains "$rid" "${ids[@]}" || extra+=("$rid")
    done < <(running_build_ids)
    if [ "${#extra[@]}" -gt 0 ]; then
      if [ "$exclusive" -eq 1 ]; then
        echo "modelctl: --exclusive - stopping build(s) outside the standing set: ${extra[*]}" >&2
        for rid in "${extra[@]}"; do
          cmd_down_one "$rid"
        done
      else
        echo "modelctl: refusing - build(s) running outside the standing set: ${extra[*]}" >&2
        echo "modelctl: pass --exclusive to stop them, or stop them yourself and re-run" >&2
        exit 1
      fi
    fi
  elif [ "$exclusive" -eq 1 ]; then
    # Plain build-id(s) + --exclusive: GPU-scoped instead of box-wide -
    # this run's targets get their GPU(s) entirely to themselves, without
    # disturbing anything running on a GPU none of them use. This is what
    # llm-inference-bench's orchestrator now delegates to instead of
    # carrying its own copy of this logic (2026-09-01, M-139).
    stop_other_builds_on_same_gpu "${ids[@]}"
  fi

  # When starting more than one build, each one waits until healthy
  # before the next one starts - all of them loading model weights into
  # the shared unified-memory pool at once is a real, confirmed-live way
  # to OOM the box, regardless of list order. A single explicit `up
  # <id>` skips the wait (nothing queued behind it to protect).
  local wait_between=0
  [ "${#ids[@]}" -gt 1 ] && wait_between=1

  local failures=0
  local id f port
  for id in "${ids[@]}"; do
    if cmd_up_one "$id"; then
      # Wait and prime for a single id too. It used to skip the wait, on the
      # reasoning that nothing was queued behind it to protect -- but that left
      # every single `up` returning a container that was not yet serving, and a
      # benchmark starting against a cold model. `up` now means "ready".
      f="$(compose_file_for "$id")"
      port="$(port_for "$f")"
      if [ -n "$port" ]; then
        wait_healthy "$id" "$port" || true
        prime_model "$id" "$port"
      fi
    else
      failures=$((failures + 1))
    fi
  done
  if [ "$failures" -gt 0 ]; then
    echo "modelctl: $failures build(s) failed to start" >&2
    exit 1
  fi
}

cmd_down_one() {
  local id="$1"
  local f
  f="$(compose_file_for "$id")"
  if [ ! -f "$f" ]; then
    echo "modelctl: no such build '$id' (missing $f)" >&2
    return 1
  fi
  # Compose project name is a label baked into the container at creation
  # time - it does not get recomputed later. A container started under an
  # older naming convention keeps that old label forever, even after this
  # script's own project_name_for() changes. Confirmed live (M-161,
  # 2026-10-06): a long-running production container's real label was
  # "qwen38-flash-next-..." (periods dropped), while today's
  # project_name_for() computes "qwen3_8-flash-next-..." (periods to
  # underscores) for the same id - genuinely different strings. `docker
  # compose -p <wrong-name> down` finds no containers under that project
  # and exits 0 having done nothing - silently, with no error - which is
  # exactly how this went unnoticed: modelctl's own "stopping $id" log line
  # printed, and the container kept running the whole time regardless.
  # Asking the running container directly for its own real label sidesteps
  # the whole class of drift, instead of trusting a name recomputed from
  # scratch to still match whatever it matched when the container was born.
  local real_project
  real_project="$(docker inspect "$id" --format '{{index .Config.Labels "com.docker.compose.project"}}' 2>/dev/null || true)"
  local project="${real_project:-$(project_name_for "$id")}"
  echo "modelctl: stopping $id"
  # Same -p reasoning as cmd_up_one - without it this would resolve to
  # the "docker" project shared with the base stack.
  docker compose -p "$project" -f "$f" down
  # Verify it actually happened rather than trusting compose's own exit
  # code: a project-name mismatch neither branch above caught would
  # otherwise report success while leaving the container running, same as
  # the original incident. Loud failure here, not a silent no-op.
  if docker ps --format '{{.Names}}' | grep -qx "$id"; then
    echo "modelctl: ERROR - '$id' is still running after 'down' (project name mismatch? real label was '${real_project:-<none>}', used '$project')" >&2
    return 1
  fi
}

cmd_down() {
  local ids=("$@")
  if [ "${#ids[@]}" -eq 0 ]; then
    ids=()
    local bid
    while IFS= read -r bid; do
      ids+=("$bid")
    done < <(all_build_ids)
  fi
  local id failures=0
  for id in "${ids[@]}"; do
    # One build failing to stop must not abort the rest of the loop -
    # the no-args form is meant to reliably sweep every build directory.
    cmd_down_one "$id" || failures=$((failures + 1))
  done
  if [ "$failures" -gt 0 ]; then
    echo "modelctl: $failures build(s) failed to stop cleanly" >&2
    exit 1
  fi
}

# `docker logs` takes exactly one container (its own usage line says so), so
# tailing several builds means one docker process per id and a prefix per line
# to keep the interleaving attributable. Everything the caller passes is
# handed to docker verbatim so `modelctl logs` behaves like `docker logs`
# rather than a subset of it: no -f prints and exits, -f follows, and
# -n/--since/--until/-t/--details all mean what they mean there.
cmd_logs() {
  local follow=0 tail_n="" since="" until="" timestamps=0 details=0
  local ids=()
  local end_of_opts=0

  # Hand-rolled, not getopts: getopts stops at the first non-option, and
  # `modelctl logs <id> -f` has to work as well as `modelctl logs -f <id>`.
  local opt
  while [ "$#" -gt 0 ]; do
    if [ "$end_of_opts" -eq 1 ]; then
      ids+=("$1")
      shift
      continue
    fi
    case "$1" in
      -h|--help)       usage ;;
      -f|--follow)     follow=1 ;;
      -t|--timestamps) timestamps=1 ;;
      --details)       details=1 ;;
      -n|--tail|--since|--until)
        opt="$1"
        shift
        if [ "$#" -eq 0 ] || [ -z "${1:-}" ]; then
          echo "modelctl logs: $opt requires a value" >&2
          exit 1
        fi
        case "$opt" in
          -n|--tail) tail_n="$1" ;;
          --since)   since="$1" ;;
          --until)   until="$1" ;;
        esac
        ;;
      --tail=*|--since=*|--until=*)
        opt="${1%%=*}"
        local val="${1#*=}"
        if [ -z "$val" ]; then
          echo "modelctl logs: $opt requires a value" >&2
          exit 1
        fi
        case "$opt" in
          --tail)  tail_n="$val" ;;
          --since) since="$val" ;;
          --until) until="$val" ;;
        esac
        ;;
      -n*)
        tail_n="${1#-n}"
        if [ -z "$tail_n" ]; then
          echo "modelctl logs: -n requires a value" >&2
          exit 1
        fi
        ;;
      --) end_of_opts=1 ;;
      -*)
        echo "modelctl logs: unknown option '$1' (ids come after 'logs', options above; use -- before an id that starts with '-')" >&2
        exit 1
        ;;
      *) ids+=("$1") ;;
    esac
    shift
  done

  # Validated here rather than left for docker to reject, because with several
  # ids one bad flag would otherwise be re-rejected once per build.
  if [ -n "$tail_n" ] && ! [[ "$tail_n" =~ ^(all|[0-9]+)$ ]]; then
    echo "modelctl logs: --tail wants an integer or \"all\", got '$tail_n'" >&2
    exit 1
  fi

  local dargs=()
  [ "$follow" -eq 1 ] && dargs+=("-f")
  [ "$timestamps" -eq 1 ] && dargs+=("-t")
  [ "$details" -eq 1 ] && dargs+=("--details")
  [ -n "$tail_n" ] && dargs+=("--tail" "$tail_n")
  [ -n "$since" ] && dargs+=("--since" "$since")
  [ -n "$until" ] && dargs+=("--until" "$until")

  if [ "${#ids[@]}" -eq 0 ]; then
    local bid
    while IFS= read -r bid; do
      ids+=("$bid")
    done < <(running_build_ids)
  fi
  if [ "${#ids[@]}" -eq 0 ]; then
    echo "modelctl: no build containers currently running" >&2
    exit 1
  fi

  # One build: pure passthrough - no prefix, docker's own exit status, no
  # subshell in the way of Ctrl-C. `--` before the id (accepted by docker's
  # own CLI parser, checked) so an id that begins with '-' is still an id.
  if [ "${#ids[@]}" -eq 1 ]; then
    exec docker logs "${dargs[@]}" -- "${ids[0]}"
  fi

  local id failed=0
  if [ "$follow" -eq 0 ]; then
    # Not following: one build at a time, so each build's history is a
    # readable block instead of a scramble. pipefail (set at the top of this
    # file) makes the pipeline fail if docker does, not just if sed does.
    for id in "${ids[@]}"; do
      docker logs "${dargs[@]}" -- "$id" 2>&1 | sed -u "s/^/[$id] /" || failed=$((failed + 1))
    done
    if [ "$failed" -gt 0 ]; then
      echo "modelctl: $failed build(s) had unreadable logs" >&2
      return 1
    fi
    return 0
  fi

  echo "modelctl: tailing ${#ids[@]} build(s), Ctrl-C to stop" >&2
  local pids=() rc=0 p
  trap 'for p in "${pids[@]}"; do kill "$p" 2>/dev/null || true; done' INT TERM
  for id in "${ids[@]}"; do
    # Process substitution, not `docker ... | sed &`: bash forks a subshell to
    # own a backgrounded pipeline, and that subshell - not docker - is what
    # $! (and so the trap above) would point at, leaving `docker logs -f`
    # running after modelctl itself is gone. This way the recorded pid IS the
    # docker process. -u so lines reach a pipe as they arrive instead of
    # sitting in sed's block buffer.
    docker logs "${dargs[@]}" -- "$id" > >(sed -u "s/^/[$id] /") 2>&1 &
    pids+=("$!")
  done
  # Wait for each follower by pid rather than a bare `wait`: a bare `wait`
  # reports success no matter what its children did, which would swallow
  # docker's own failure status (a mistyped id, an unreadable container) on
  # the way out. Statuses stay available until reaped, so waiting each
  # recorded pid once still sees the ones that already exited.
  for p in "${pids[@]}"; do
    wait "$p" || rc=$?
  done
  trap - INT TERM
  # Give the prefixers a moment to flush what they already have: the sed
  # processes come from process substitution, so `wait` above does not wait
  # for them and they would otherwise be writing into a half-exited script.
  sleep 0.1
  # A stop signal (128+SIGNUM from `wait`) is a normal end to following, not
  # an error; anything else is docker's own failure on at least one build.
  [ "$rc" -ge 128 ] && return 0
  return "$rc"
}

always_up_for() {
  local f="$1"
  grep -q 'com\.local-ai-machine\.always-up: "true"' "$f"
}

cmd_list() {
  printf '%-14s %-9s %-6s %s\n' "STATUS" "STANDING" "DOWNLOADED" "BUILD"
  local id f running standing downloaded
  local running_ids=()
  local rid
  while IFS= read -r rid; do
    running_ids+=("$rid")
  done < <(running_build_ids)
  while IFS= read -r id; do
    f="$(compose_file_for "$id")"
    if contains "$id" "${running_ids[@]:-}"; then running="RUNNING"; else running="stopped"; fi
    if always_up_for "$f"; then standing="yes"; else standing="-"; fi
    local model_dir
    if model_dir="$(model_dir_for "$f")"; then
      if [ -f "$model_dir/.download-complete" ]; then downloaded="yes"; else downloaded="no"; fi
    else
      downloaded="?"
    fi
    printf '%-14s %-9s %-6s %s\n' "$running" "$standing" "$downloaded" "$id"
  done < <(all_build_ids)
}

cmd_ps() {
  local ids=()
  local bid
  while IFS= read -r bid; do
    ids+=("$bid")
  done < <(running_build_ids)
  if [ "${#ids[@]}" -eq 0 ]; then
    echo "modelctl: no build containers currently running" >&2
    return
  fi
  docker ps --filter "name=^($( IFS='|'; echo "${ids[*]}" ))$" \
    --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
}

cmd_exec() {
  local id="${1:-}"
  if [ -z "$id" ]; then
    echo "modelctl exec: requires a build id" >&2
    usage
  fi
  shift
  if ! docker ps --format '{{.Names}}' | grep -qx "$id"; then
    echo "modelctl: '$id' is not currently running" >&2
    exit 1
  fi
  if [ "$#" -eq 0 ]; then
    exec docker exec -it "$id" sh
  fi
  exec docker exec -it "$id" "$@"
}

case "${1:-}" in
  up)
    shift
    cmd_up "$@"
    ;;
  down)
    shift
    cmd_down "$@"
    ;;
  logs)
    shift
    cmd_logs "$@"
    ;;
  list)
    cmd_list
    ;;
  ps)
    cmd_ps
    ;;
  exec)
    shift
    cmd_exec "$@"
    ;;
  *)
    usage
    ;;
esac
