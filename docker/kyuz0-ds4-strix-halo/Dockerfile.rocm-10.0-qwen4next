# Adapted from kyuz0/strix-halo-ds4-toolbox's toolboxes/Dockerfile.rocm-10.0,
# retargeted at the Qwen3.8-Flash-Next integration branch (draft PR
# antirez/ds4#1070, actual head kyuz0/ds4@codex/qwen38-main-integration-20260917).
# That branch's own PR description states it already includes its
# prerequisite changes from PR #1036, so no separate merge of #1036 is needed.
#
# The three feature patches below (PR #2, #1012, #1165) are unrelated,
# opt-in features carried by the toolbox's main-gfx1151 build; they are not
# required for a basic working build and are applied best-effort here since
# they may not apply cleanly against this different branch.

# build stage
FROM registry.fedoraproject.org/fedora:44 AS builder

# ROCm 10.0 Core SDK repository
RUN <<'EOF'
tee /etc/yum.repos.d/rocm.repo <<REPO
[amdrocm-stable]
name=ROCm 10.0.0
baseurl=https://stable.repo.amd.com/rocm/core/packages/rhel10/x86_64
enabled=1
priority=50
gpgcheck=1
gpgkey=https://stable.repo.amd.com/rocm/gpg/packages.gpg
REPO
EOF

# Build with AMD's supported gfx1151 development meta-package.
RUN dnf -y --nodocs --setopt=install_weak_deps=False \
  install \
  make gcc gcc-c++ cmake libcurl-devel ninja-build \
  amdrocm-core-devel10.0-gfx1151 \
  rdma-core-devel \
  git-core vim sudo rsync patch \
  && dnf clean all && rm -rf /var/cache/dnf/*

ENV ROCM_PATH=/opt/rocm \
  HIP_PATH=/opt/rocm \
  PATH=/opt/rocm/bin:/opt/rocm/core/bin:/opt/rocm/core/lib/llvm/bin:$PATH \
  LD_LIBRARY_PATH=/opt/rocm/core/lib/rocm_sysdeps/lib:/opt/rocm/core/lib

# ds4 — Qwen3.8-Flash-Next integration branch (draft PR #1070)
WORKDIR /opt/ds4
ARG REPO=https://github.com/kyuz0/ds4.git
ARG BRANCH=codex/qwen38-main-integration-20260917
# Pin the exact commit this image was built from (reproducibility convention
# used by every other build in this repo). Override at build time with:
#   gh api repos/kyuz0/ds4/commits/${BRANCH} --jq .sha
ARG ENGINE_COMMIT=7f2b9cf41e9c8e790ba35f4b4ac362f3dc7bd782
# PR #2: deepseek41: add opt-in decoder SWA bounded replay
# PR #1012: Server: preserve raw prompts in /v1/completions
# PR #1165: Server: advertise loaded model modalities
# These are unrelated feature patches carried over from the toolbox's
# main-gfx1151 Dockerfile; best-effort only against this branch.
RUN git clone -b ${BRANCH} --single-branch ${REPO} . \
  && git clean -xdf \
  && git checkout ${ENGINE_COMMIT} \
  && ( curl --fail --location --retry 3 \
     --output /tmp/ds4-pr-2.patch https://github.com/kyuz0/ds4/pull/2.patch \
     && git -c user.name='ds4 toolbox build' -c user.email='ds4-build@localhost' \
        am /tmp/ds4-pr-2.patch \
     || git am --abort || true ) \
  && ( curl --fail --location --retry 3 \
     --output /tmp/ds4-pr-1012.patch https://github.com/antirez/ds4/pull/1012.patch \
     && git -c user.name='ds4 toolbox build' -c user.email='ds4-build@localhost' \
        am /tmp/ds4-pr-1012.patch \
     || git am --abort || true ) \
  && ( curl --fail --location --retry 3 \
     --output /tmp/ds4-pr-1165.patch https://github.com/antirez/ds4/pull/1165.patch \
     && git -c user.name='ds4 toolbox build' -c user.email='ds4-build@localhost' \
        am /tmp/ds4-pr-1165.patch \
     || git am --abort || true ) \
  && git log -1 --format='ds4 source: %H %s' \
  && make -j"$(nproc)" strix-halo ROCM_ARCH=gfx1151 \
     CFLAGS="-O3 -ffast-math -march=native -Wall -Wextra -std=c99 -D_GNU_SOURCE -fno-finite-math-only -fPIC" \
  && cp ds4 ds4-server ds4-bench ds4-eval ds4-agent download_model.sh /usr/local/bin/

# runtime stage
FROM registry.fedoraproject.org/fedora-minimal:44

# ROCm 10.0 Core SDK repository
RUN <<'EOF'
tee /etc/yum.repos.d/rocm.repo <<REPO
[amdrocm-stable]
name=ROCm 10.0.0
baseurl=https://stable.repo.amd.com/rocm/core/packages/rhel10/x86_64
enabled=1
priority=50
gpgcheck=1
gpgkey=https://stable.repo.amd.com/rocm/gpg/packages.gpg
REPO
EOF

# Runtime components required by ds4's HIP backend.
RUN microdnf -y --nodocs --setopt=install_weak_deps=0 \
  install \
  bash ca-certificates diffutils libatomic libstdc++ libgcc libgomp sudo \
  amdrocm10.0-gfx1151 \
  libibverbs libibverbs-utils \
  radeontop procps-ng \
  python3-pip \
  && microdnf clean all && rm -rf /var/cache/dnf/* \
  && ln -s core-10.0 /opt/rocm/core \
  && ln -s core-10.0/bin /opt/rocm/bin \
  && ln -s core-10.0/include /opt/rocm/include \
  && ln -s core-10.0/lib /opt/rocm/lib \
  && ln -s core-10.0/libexec /opt/rocm/libexec \
  && ln -s core-10.0/lib/llvm /opt/rocm/llvm \
  && ln -s core-10.0/share /opt/rocm/share \
  && ln -s core-10.0/lib/llvm/amdgcn /opt/rocm/amdgcn

ENV ROCM_PATH=/opt/rocm \
  HIP_PATH=/opt/rocm \
  PATH=/opt/rocm/bin:/opt/rocm/core/bin:/opt/rocm/core/lib/llvm/bin:$PATH \
  LD_LIBRARY_PATH=/opt/rocm/core/lib/rocm_sysdeps/lib:/opt/rocm/core/lib

# hf CLI for model downloads (hf_xet enables HF_XET_HIGH_PERFORMANCE=1)
RUN pip install --no-cache-dir 'huggingface_hub[hf_xet]'

# copy
COPY --from=builder /usr/local/ /usr/local/

# ld
RUN echo "/usr/local/lib"  > /etc/ld.so.conf.d/local.conf \
  && echo "/usr/local/lib64" >> /etc/ld.so.conf.d/local.conf \
  && echo "/opt/rocm/core/lib" > /etc/ld.so.conf.d/rocm.conf \
  && echo "/opt/rocm/core/lib/rocm_sysdeps/lib" >> /etc/ld.so.conf.d/rocm.conf \
  && ldconfig

# Toolbox/Distrobox shares the host home directory. Prevent the host's
# ~/.local/lib/python* from shadowing container-installed packages
# (e.g. hf CLI importing the host's broken huggingface_hub).
ENV PYTHONNOUSERSITE=1

CMD ["/bin/bash"]
