# M-138: pulled verbatim (Dockerfile + both patches) from
# https://github.com/Aristo94/EngramHalo.cpp/tree/strix-halo-qwen4exp
# (commit as of 2026-08-29, 17 stars, third-party fork, not upstream
# llama.cpp) - the only branch found with a working MTP draft head for
# Qwen3.8-Flash-Next (qwen4exp) on Strix Halo. Chris explicitly confirmed
# this specific fork before it was downloaded/built (two other candidate
# branches were also found: rmonsurate/llama.cpp `qwen4exp-mtp` (raw PR
# #27836, unmerged) and drluoto/llama.cpp `strix-halo-flash-next` (PR
# #27836 + 3 community fixes) - this one was chosen for its dedicated
# Strix-Halo kernel patches (real long-context decode fix, not just MTP
# wiring) and its own tested Dockerfile/benchmarks. Reviewed both patch
# files before use (small, focused, no red flags). Backend is ROCm/HIP
# only by design - the fork's own docs report Vulkan/RADV as a net loss
# for MTP on this chip, consistent with our own base-model finding that
# Vulkan is the safer backend for the BASE model specifically (issue
# #27856's decode cliff is HIP-specific) - the two findings aren't in
# conflict, they're about different code paths (base decode vs. MTP
# draft graph).
#
# llama.cpp for AMD Strix Halo (gfx1151) — ROCm 7.14, builds the strix-halo-qwen4exp branch.
# Container layout follows kyuz0/amd-strix-halo-toolboxes. Use with podman/toolbox:
#   podman build -f Dockerfile.rocm-7.14 -t engramhalo .
#   toolbox create engramhalo --image localhost/engramhalo -- \
#     --device /dev/dri --device /dev/kfd --group-add video --group-add render --security-opt seccomp=unconfined
# (this repo builds/runs it via plain `docker build`/`docker compose`, not podman/toolbox -
# the Dockerfile itself needs no changes for that, only the invocation differs)

# build stage
FROM registry.fedoraproject.org/fedora:44 AS builder

RUN <<'EOF'
tee /etc/yum.repos.d/rocm.repo <<REPO
[rocm]
name=ROCm 7.14.0
baseurl=https://repo.amd.com/rocm/packages-multi-arch/rhel10/x86_64
enabled=1
priority=50
gpgcheck=1
gpgkey=https://repo.amd.com/rocm/packages-multi-arch/gpg/rocm.gpg
REPO
EOF

RUN dnf -y --nodocs --setopt=install_weak_deps=False \
  install \
  make gcc gcc-c++ cmake libcurl-devel ninja-build rdma-core-devel \
  amdrocm-core-devel7.14-gfx1151 \
  git-core sudo rsync patch \
  && dnf clean all && rm -rf /var/cache/dnf/*

ENV ROCM_PATH=/opt/rocm \
  HIP_PATH=/opt/rocm \
  PATH=/opt/rocm/bin:/opt/rocm/core/bin:/opt/rocm/core/lib/llvm/bin:$PATH \
  LD_LIBRARY_PATH=/opt/rocm/core/lib/rocm_sysdeps/lib:/opt/rocm/core/lib

WORKDIR /opt/llama.cpp
ARG REPO=https://github.com/Aristo94/EngramHalo.cpp.git
ARG BRANCH=strix-halo-qwen4exp
RUN git clone -b ${BRANCH} --single-branch --recursive ${REPO} .

# iGPU host-buffer workaround for ggml-org/llama.cpp#25992 (based on the open upstream PR #25863,
# packaged in kyuz0/amd-strix-halo-toolboxes). It disables ROCm host-buffer compute on integrated
# GPUs: a correctness workaround for the multi-slot response mix-up reported in #25992. It also
# determines where the engram gathers get scheduled with -lm none.
COPY llama-cpp-25992-rocm-host-buffer.patch /tmp/
# Loader patch used in the measured builds (per-buffer mmap / async uploads). Applied when it
# still fits the tree, skipped as obsolete otherwise.
COPY llama-cpp-qwen38-per-buffer-mmap.patch /tmp/
RUN if git apply --check /tmp/llama-cpp-25992-rocm-host-buffer.patch; then \
      git apply /tmp/llama-cpp-25992-rocm-host-buffer.patch; \
    elif git apply --reverse --check /tmp/llama-cpp-25992-rocm-host-buffer.patch; then \
      echo "#25992 workaround already present upstream"; \
    else \
      echo "WARNING: #25992 workaround no longer applies; multi-slot serving may return wrong responses"; \
    fi \
  && if git apply --check /tmp/llama-cpp-qwen38-per-buffer-mmap.patch; then \
      git apply /tmp/llama-cpp-qwen38-per-buffer-mmap.patch; \
    else \
      echo "per-buffer mmap loader patch skipped as obsolete"; \
    fi \
  && cmake -S . -B build \
  -DGGML_HIP=ON \
  -DAMDGPU_TARGETS=gfx1151 \
  -DCMAKE_BUILD_TYPE=Release \
  -DGGML_RPC=ON \
  -DROCM_PATH=/opt/rocm \
  -DHIP_PLATFORM=amd \
  && cmake --build build --config Release -- -j$(nproc) \
  && cmake --install build --config Release

RUN mkdir -p /usr/local/lib64 \
  && find /opt/llama.cpp/build -type f -name 'lib*.so*' -exec cp {} /usr/local/lib64/ \; \
  && ldconfig

# runtime stage
FROM registry.fedoraproject.org/fedora-minimal:44

RUN <<'EOF'
tee /etc/yum.repos.d/rocm.repo <<REPO
[rocm]
name=ROCm 7.14.0
baseurl=https://repo.amd.com/rocm/packages-multi-arch/rhel10/x86_64
enabled=1
priority=50
gpgcheck=1
gpgkey=https://repo.amd.com/rocm/packages-multi-arch/gpg/rocm.gpg
REPO
EOF

RUN microdnf -y --nodocs --setopt=install_weak_deps=0 \
  install \
  bash ca-certificates libatomic libstdc++ libgcc libgomp libibverbs sudo \
  amdrocm-runtime7.14 amdrocm-blas7.14-gfx1151 \
  radeontop procps-ng \
  && microdnf clean all && rm -rf /var/cache/dnf/* \
  && ln -s core-7.14 /opt/rocm/core \
  && ln -s core-7.14/bin /opt/rocm/bin \
  && ln -s core-7.14/include /opt/rocm/include \
  && ln -s core-7.14/lib /opt/rocm/lib \
  && ln -s core-7.14/libexec /opt/rocm/libexec \
  && ln -s core-7.14/lib/llvm /opt/rocm/llvm \
  && ln -s core-7.14/share /opt/rocm/share \
  && ln -s core-7.14/lib/llvm/amdgcn /opt/rocm/amdgcn

ENV ROCM_PATH=/opt/rocm \
  HIP_PATH=/opt/rocm \
  PATH=/opt/rocm/bin:/opt/rocm/core/bin:/opt/rocm/core/lib/llvm/bin:$PATH \
  LD_LIBRARY_PATH=/opt/rocm/core/lib/rocm_sysdeps/lib:/opt/rocm/core/lib

COPY --from=builder /usr/local/ /usr/local/
RUN echo "/usr/local/lib" > /etc/ld.so.conf.d/local.conf \
  && echo "/usr/local/lib64" >> /etc/ld.so.conf.d/local.conf \
  && echo "/opt/rocm/core/lib" > /etc/ld.so.conf.d/rocm.conf \
  && echo "/opt/rocm/core/lib/rocm_sysdeps/lib" >> /etc/ld.so.conf.d/rocm.conf \
  && ldconfig \
  && find /usr/local/lib /usr/local/lib64 -maxdepth 1 -type f -name 'libllama*.so*' \
     -exec cp -n {} /usr/lib64/ \; \
  && ldconfig

CMD ["/bin/bash"]
